// Luau C API Playground / Cheat-Sheet
// ─────────────────────────────────────────────────────────────────────────────
// Build (from repo root):
//   ninja -C build test-luau
// Run:
//   ./build/playground/test-luau
//
// Each PlaygroundFunc(Name, { ... }) block is a self-contained example.
// Add CheckPlaygroundFunc(Name) in main() to run it.
// ─────────────────────────────────────────────────────────────────────────────
#include <lua.h>
#include <lualib.h>
#include <luacode.h>
#include <cctype>
#include <cmath>
#include <cstdlib>
#include <cstring>
#include <cstdio>
#include "util.hpp"
#include <iostream>

// ─────────────────────────────────────────────────────────────────────────────
// HELPER: compile Luau source → bytecode → luau_load → lua_pcall
//
// Luau has no luaL_dostring / luaL_loadfile — this is the canonical replacement.
// luau_compile() encodes compile errors into the bytecode blob itself; luau_load
// surfaces them as LUA_ERRSYNTAX so we get consistent error handling in one place.
//
// On LUA_OK any values returned by the chunk are left on the stack.
// On failure the error is printed, popped from the stack, and the status returned.
// ─────────────────────────────────────────────────────────────────────────────
static int runLuau(lua_State* L, const char* src, const char* chunkname = "=[C]") {
    size_t bcLen = 0;
    // Always use free() on the pointer returned by luau_compile.
    char* bc = luau_compile(src, strlen(src), nullptr, &bcLen);
    int status = luau_load(L, chunkname, bc, bcLen, 0);
    free(bc);
    if (status != LUA_OK) {
        printf("  [load err] %s\n", lua_tostring(L, -1));
        lua_pop(L, 1);
        return status;
    }
    status = lua_pcall(L, 0, LUA_MULTRET, 0);
    if (status != LUA_OK) {
        printf("  [runtime err] %s\n", lua_tostring(L, -1));
        lua_pop(L, 1);
    }
    return status;
}

// ─────────────────────────────────────────────────────────────────────────────
// 1. STACK BASICS
//   Everything in the Lua C API passes through the value stack.
//   Positive indices (1, 2, …) count from the bottom.
//   Negative indices (-1, -2, …) count from the top (-1 = top).
// ─────────────────────────────────────────────────────────────────────────────
PlaygroundFunc(StackBasics, {
    lua_State* L = luaL_newstate();

    // ── Push every primitive type ────────────────────────────────────────────
    lua_pushnil(L);                       // [nil]
    lua_pushboolean(L, 1);                // [nil, true]
    lua_pushnumber(L, 3.14);              // [..., 3.14]
    lua_pushinteger(L, 42);               // [..., 42]      (lua_Integer is int32 in Luau!)
    lua_pushunsigned(L, 0xDEADBEEFu);    // [..., 3735928559]
    lua_pushstring(L, "hello luau");      // [..., "hello luau"]
    lua_pushlightuserdata(L, (void*)L);   // [..., lightuserdata]

    int top = lua_gettop(L);              // depth = 7
    printf("  stack depth: %d\n", top);

    // ── Inspect types ────────────────────────────────────────────────────────
    for (int i = 1; i <= top; i++) {
        int t = lua_type(L, i);
        printf("  [%d] %-14s", i, lua_typename(L, t));
        switch (t) {
            case LUA_TNIL:           printf("(nil)\n"); break;
            case LUA_TBOOLEAN:       printf("%d\n", lua_toboolean(L, i)); break;
            case LUA_TNUMBER:        printf("%g\n",  lua_tonumber(L, i)); break;
            case LUA_TSTRING:        printf("%s\n",  lua_tostring(L, i)); break;
            case LUA_TLIGHTUSERDATA: printf("%p\n",  lua_tolightuserdata(L, i)); break;
            default:                 printf("\n"); break;
        }
    }

    // ── Stack manipulation ───────────────────────────────────────────────────
    lua_pushvalue(L, 4);     // duplicate index 4 (the integer 42) → push copy
    lua_insert(L, 1);        // move top to position 1, shift others up
    lua_remove(L, 2);        // remove position 2, shift others down
    lua_replace(L, -2);      // pop top, store into position -2 (overwrites it)

    // lua_settop(L, n): set the stack to exactly n elements.
    // If n < current top: truncates.  If n > current top: pads with nil.
    lua_settop(L, 3);
    printf("  after manipulation, depth=%d\n", lua_gettop(L));

    // lua_absindex converts any index (including negative) to an absolute one.
    int abs = lua_absindex(L, -1);
    printf("  absindex(-1) = %d (same as gettop)\n", abs);

    // lua_pop(L, n) is a macro for lua_settop(L, -(n)-1)
    lua_pop(L, lua_gettop(L));
    lua_close(L);
})

// ─────────────────────────────────────────────────────────────────────────────
// 2. EXECUTE LUAU SOURCE CODE
//   Luau has no luaL_dostring / luaL_loadfile.  Always:
//     1. luau_compile(src, len, opts, &outLen)  → malloc'd bytecode blob
//     2. luau_load(L, chunkname, bc, bcLen, env) → pushes chunk as function
//     3. lua_pcall(L, 0, LUA_MULTRET, 0)
//     4. free(bc)
//   The runLuau() helper above wraps all four steps.
// ─────────────────────────────────────────────────────────────────────────────
PlaygroundFunc(ExecuteLuauCode, {
    lua_State* L = luaL_newstate();
    luaL_openlibs(L);

    // ── Basic snippet ────────────────────────────────────────────────────────
    runLuau(L, R"(
        print("  1 + 2 = " .. tostring(1 + 2))
        for i, v in ipairs({10, 20, 30}) do
            print("  t[" .. i .. "] = " .. v)
        end
    )");

    // ── Compile with custom options ──────────────────────────────────────────
    // optimizationLevel 0/1/2; debugLevel 0/1/2; coverageLevel 0/1/2
    lua_CompileOptions opts{};
    opts.optimizationLevel = 2; // aggressive — disables some debug info
    opts.debugLevel        = 1; // line numbers + function names

    const char* src = "return 42, 'answer'";
    size_t bcLen = 0;
    char* bc = luau_compile(src, strlen(src), &opts, &bcLen);
    luau_load(L, "=[ret]", bc, bcLen, 0);
    free(bc);
    int base = lua_gettop(L) - 1; // function is on stack
    lua_pcall(L, 0, LUA_MULTRET, 0);
    printf("  chunk returned %d values: %d, \"%s\"\n",
        lua_gettop(L) - base,
        (int)lua_tointeger(L, base + 1),
        lua_tostring(L, base + 2));
    lua_settop(L, base);

    // ── Syntax errors ────────────────────────────────────────────────────────
    // luau_compile encodes them into the bytecode; luau_load surfaces LUA_ERRSYNTAX.
    int r = runLuau(L, "local x = !!! bad syntax");
    printf("  syntax error status: %d (non-zero = error)\n", r);

    lua_close(L);
})

// ─────────────────────────────────────────────────────────────────────────────
// 3. C FUNCTIONS REGISTERED AS LUAU GLOBALS
//   C functions callable from Luau have signature: int fn(lua_State* L)
//   Arguments arrive on the stack starting at index 1.
//   Return values are pushed before returning; the return value is the count.
//
//   LUAU DIFFERENCE: lua_pushcfunction(L, fn, debugname) takes 3 args, not 2.
//   It's a macro for lua_pushcclosurek(L, fn, debugname, 0, NULL).
// ─────────────────────────────────────────────────────────────────────────────
static int c_add(lua_State* L) {
    // luaL_check* validate type and extract value; raise a Lua error on mismatch.
    double a = luaL_checknumber(L, 1);
    double b = luaL_checknumber(L, 2);
    lua_pushnumber(L, a + b);
    return 1; // number of return values left on stack
}

static int c_describe(lua_State* L) {
    luaL_checkany(L, 1);
    int t = lua_type(L, 1);
    size_t len;
    // luaL_tolstring converts any value to string (calls __tostring if present),
    // pushes the result, and returns the C string.
    const char* s = luaL_tolstring(L, 1, &len);
    lua_pushfstring(L, "%s(%s)", lua_typename(L, t), s);
    lua_remove(L, -2); // remove the tolstring result, keep our formatted string
    return 1;
}

PlaygroundFunc(CFunctionAsLuauGlobal, {
    lua_State* L = luaL_newstate();
    luaL_openlibs(L);

    lua_pushcfunction(L, c_add,      "add");      lua_setglobal(L, "add");
    lua_pushcfunction(L, c_describe, "describe"); lua_setglobal(L, "describe");

    runLuau(L, R"(
        print("  3 + 4 = "           .. add(3, 4))
        print("  describe(true) = "  .. describe(true))
        print("  describe({}) = "    .. describe({}))
        print("  describe(nil) = "   .. describe(nil))
    )");

    // ── Argument validation helpers ──────────────────────────────────────────
    // luaL_checkstring(L, n)          — returns const char*, raises on failure
    // luaL_checkinteger(L, n)         — int
    // luaL_checkboolean(L, n)         — int (0 or 1)
    // luaL_checkunsigned(L, n)        — unsigned
    // luaL_checkvector(L, n)          — const float* (Luau-only)
    // luaL_checkudata(L, n, "TName") — void*, checks metatable name
    // luaL_optstring/optnumber/optinteger(L, n, default) — same but with fallback
    // luaL_typeerror(L, n, "expected") — raises "bad argument #n (expected got X)"
    // luaL_argerror(L, n, "msg")       — raises "bad argument #n (msg)"

    lua_close(L);
})

// ─────────────────────────────────────────────────────────────────────────────
// 4. CALLING LUA FUNCTIONS FROM C
//   Pattern: push function → push args → lua_pcall(L, nargs, nresults, msgh)
//   An error handler (message handler) at stack index msgh can augment errors.
//   msgh=0 means no handler (raw error object).
// ─────────────────────────────────────────────────────────────────────────────
PlaygroundFunc(CallLuaFunctionFromC, {
    lua_State* L = luaL_newstate();
    luaL_openlibs(L);

    runLuau(L, "function greet(name) return 'Hello, ' .. name .. '!' end");

    // ── Basic call ───────────────────────────────────────────────────────────
    lua_getglobal(L, "greet");         // push function
    lua_pushstring(L, "AwesomeWM");    // push arg 1
    lua_pcall(L, 1, 1, 0);            // call(1 arg, 1 result, no handler)
    printf("  %s\n", lua_tostring(L, -1));
    lua_pop(L, 1);

    // ── LUA_MULTRET: receive all return values ────────────────────────────────
    runLuau(L, "function multi() return 1, 'two', true end");
    int base = lua_gettop(L);
    lua_getglobal(L, "multi");
    lua_pcall(L, 0, LUA_MULTRET, 0);
    printf("  multi() returned %d values\n", lua_gettop(L) - base);
    lua_settop(L, base);

    // ── Error handler (traceback) ─────────────────────────────────────────────
    lua_pushcfunction(L, [](lua_State* L2) -> int {
        const char* msg = lua_tostring(L2, 1);
        luaL_traceback(L2, L2, msg, 1); // appends traceback to the message
        return 1;
    }, "errHandler");
    int errIdx = lua_gettop(L);

    lua_getglobal(L, "greet");
    lua_pushnil(L); // wrong type — triggers a string concat error inside Lua
    int s = lua_pcall(L, 1, 1, errIdx);
    if (s != LUA_OK) {
        printf("  caught (with traceback): %.60s...\n", lua_tostring(L, -1));
        lua_pop(L, 1);
    }
    lua_pop(L, 1); // pop error handler

    // ── lua_call: unprotected call (propagates errors as C longjmp) ──────────
    // Only safe when you're already inside a protected context.
    lua_getglobal(L, "greet");
    lua_pushstring(L, "world");
    lua_call(L, 1, 1); // no error protection — would crash if greet threw
    printf("  lua_call result: %s\n", lua_tostring(L, -1));
    lua_pop(L, 1);

    lua_close(L);
})

// ─────────────────────────────────────────────────────────────────────────────
// 5. TABLE MANIPULATION
//   lua_createtable(L, narr, nrec) — pre-allocate array/hash slots (hint)
//   lua_settable / lua_gettable    — goes through __newindex / __index
//   lua_rawset / lua_rawget        — bypasses metamethods (faster)
//   lua_rawseti / lua_rawgeti      — integer keys, no metamethods
//   lua_rawsetfield / lua_rawgetfield — string keys, no metamethods (Luau)
//   lua_next(L, tbl)               — generic next-key iteration (like pairs())
//   lua_rawiter(L, tbl, iter)      — Luau-specific O(n) safe iteration
//   lua_objlen(L, idx)             — length (#) of table/string/userdata
// ─────────────────────────────────────────────────────────────────────────────
PlaygroundFunc(TableManipulation, {
    lua_State* L = luaL_newstate();
    luaL_openlibs(L);

    lua_createtable(L, 4, 2); // hint: 4 array slots, 2 hash slots
    int tbl = lua_gettop(L);

    // Array part: use rawseti for sequential integer keys (fastest)
    for (int i = 1; i <= 4; i++) {
        lua_pushinteger(L, i * 100);
        lua_rawseti(L, tbl, i);
    }

    // Hash part: string keys
    lua_pushstring(L, "awesome");
    lua_setfield(L, tbl, "name");      // goes through __newindex if present

    lua_pushboolean(L, 1);
    lua_rawsetfield(L, tbl, "active"); // skips __newindex (Luau-only rawsetfield)

    // Read values
    lua_rawgeti(L, tbl, 2);
    printf("  table[2]    = %d\n", (int)lua_tointeger(L, -1)); lua_pop(L, 1);
    lua_getfield(L, tbl, "name");
    printf("  table.name  = %s\n", lua_tostring(L, -1)); lua_pop(L, 1);
    printf("  #table      = %d\n", lua_objlen(L, tbl)); // sequence length

    // ── lua_next: generic iteration (equivalent to pairs()) ──────────────────
    // Push nil as the initial key; lua_next pops it and pushes next key+value.
    // Returns 0 when done (key is popped automatically).
    // WARNING: do NOT call lua_tostring on the key directly — use a copy if you
    // need it after the next call, as string coercion may change the key's type.
    printf("  lua_next:\n");
    lua_pushnil(L);
    while (lua_next(L, tbl)) {
        // Stack: key@-2, value@-1
        int kt = lua_type(L, -2);
        if (kt == LUA_TNUMBER)
            printf("    [%d] = %s\n", (int)lua_tointeger(L, -2), lua_typename(L, lua_type(L, -1)));
        else
            printf("    [%s] = %s\n", lua_tostring(L, -2), lua_typename(L, lua_type(L, -1)));
        lua_pop(L, 1); // pop value; keep key for next lua_next
    }

    // ── lua_rawiter: Luau-specific integer-indexed iteration ─────────────────
    // Safer than lua_next: the integer iterator index can't become invalid if
    // the table is modified.  Start iter=0; loop until return value < 0.
    // Each call pushes key@-2 and value@-1; you must pop both before next call.
    printf("  lua_rawiter (array keys only shown):\n");
    for (int iter = 0; (iter = lua_rawiter(L, tbl, iter)) >= 0; ) {
        if (lua_type(L, -2) == LUA_TNUMBER)
            printf("    [%d] = %d\n", (int)lua_tointeger(L, -2), (int)lua_tointeger(L, -1));
        lua_pop(L, 2); // must pop both key and value each iteration
    }

    lua_close(L);
})

// ─────────────────────────────────────────────────────────────────────────────
// 6. METATABLES
//   Metatables hook Lua operators and field access on tables and userdata.
//   Common metamethods: __index, __newindex, __tostring, __len, __eq,
//     __add, __sub, __mul, __div, __concat, __call, __gc (userdata only)
//   luaL_newmetatable(L, name) — creates/reuses a named entry in the registry,
//     pushes it.  Idiomatic way to define a "class" metatable.
//   luaL_getmetatable(L, name) — re-fetch it later.
// ─────────────────────────────────────────────────────────────────────────────
PlaygroundFunc(MetatableBasics, {
    lua_State* L = luaL_newstate();
    luaL_openlibs(L);

    // ── Register a Vec2 "class" metatable ────────────────────────────────────
    luaL_newmetatable(L, "Vec2");
    int mt = lua_gettop(L);

    lua_pushcfunction(L, [](lua_State* L2) -> int {
        lua_getfield(L2, 1, "x"); lua_getfield(L2, 1, "y");
        lua_pushfstring(L2, "Vec2(%g, %g)", lua_tonumber(L2, -2), lua_tonumber(L2, -1));
        return 1;
    }, "Vec2.__tostring");
    lua_setfield(L, mt, "__tostring");

    lua_pushcfunction(L, [](lua_State* L2) -> int {
        lua_getfield(L2, 1, "x"); double ax = lua_tonumber(L2, -1);
        lua_getfield(L2, 1, "y"); double ay = lua_tonumber(L2, -1);
        lua_getfield(L2, 2, "x"); double bx = lua_tonumber(L2, -1);
        lua_getfield(L2, 2, "y"); double by = lua_tonumber(L2, -1);
        lua_settop(L2, 0);
        lua_getglobal(L2, "Vec2"); lua_pushnumber(L2, ax+bx); lua_pushnumber(L2, ay+by);
        lua_call(L2, 2, 1);
        return 1;
    }, "Vec2.__add");
    lua_setfield(L, mt, "__add");

    // __index = the metatable itself so methods stored in mt are found via :method()
    lua_pushvalue(L, mt);
    lua_setfield(L, mt, "__index");

    lua_pushcfunction(L, [](lua_State* L2) -> int {
        lua_getfield(L2, 1, "x"); double x = lua_tonumber(L2, -1);
        lua_getfield(L2, 1, "y"); double y = lua_tonumber(L2, -1);
        lua_pushnumber(L2, sqrt(x*x + y*y));
        return 1;
    }, "Vec2.length");
    lua_setfield(L, mt, "length");

    lua_pop(L, 1); // pop the metatable

    // ── Vec2 constructor ──────────────────────────────────────────────────────
    lua_pushcfunction(L, [](lua_State* L2) -> int {
        lua_createtable(L2, 0, 2);
        lua_pushnumber(L2, luaL_optnumber(L2, 1, 0.0)); lua_setfield(L2, -2, "x");
        lua_pushnumber(L2, luaL_optnumber(L2, 2, 0.0)); lua_setfield(L2, -2, "y");
        luaL_getmetatable(L2, "Vec2"); lua_setmetatable(L2, -2);
        return 1;
    }, "Vec2.new");
    lua_setglobal(L, "Vec2");

    runLuau(L, R"(
        local a = Vec2(3, 4)
        local b = Vec2(1, 1)
        print("  a         = " .. tostring(a))
        print("  b         = " .. tostring(b))
        print("  a + b     = " .. tostring(a + b))
        print("  a:length()= " .. a:length())
    )");

    lua_close(L);
})

// ─────────────────────────────────────────────────────────────────────────────
// 7. USERDATA WITH AUTOMATIC DESTRUCTOR (lua_newuserdatadtor)
//   Full userdata = GC-managed block of memory with an optional destructor.
//   lua_newuserdatadtor(L, sz, dtor) allocates sz bytes and calls dtor(ptr)
//   when the GC collects it — no __gc metamethod needed.
//   luaL_checkudata(L, idx, "TName") validates the metatable and returns void*.
// ─────────────────────────────────────────────────────────────────────────────
struct MyBuffer { char* data; size_t len; };

static int c_mybuffer_read(lua_State* L) {
    MyBuffer* b = (MyBuffer*)luaL_checkudata(L, 1, "MyBuffer");
    lua_pushlstring(L, b->data, b->len);
    return 1;
}
static int c_mybuffer_size(lua_State* L) {
    MyBuffer* b = (MyBuffer*)luaL_checkudata(L, 1, "MyBuffer");
    lua_pushinteger(L, (int)b->len);
    return 1;
}

PlaygroundFunc(UserdataWithDtor, {
    lua_State* L = luaL_newstate();
    luaL_openlibs(L);

    // ── Register the metatable ────────────────────────────────────────────────
    luaL_newmetatable(L, "MyBuffer");
    int mt = lua_gettop(L);

    lua_pushcfunction(L, c_mybuffer_read, "MyBuffer.read"); lua_setfield(L, mt, "read");
    lua_pushcfunction(L, c_mybuffer_size, "MyBuffer.size"); lua_setfield(L, mt, "size");

    lua_pushcfunction(L, [](lua_State* L2) -> int {
        MyBuffer* b = (MyBuffer*)luaL_checkudata(L2, 1, "MyBuffer");
        lua_pushfstring(L2, "MyBuffer(%d bytes)", (int)b->len);
        return 1;
    }, "MyBuffer.__tostring");
    lua_setfield(L, mt, "__tostring");

    lua_pushvalue(L, mt); lua_setfield(L, mt, "__index"); // mt.__index = mt
    lua_pop(L, 1);

    // ── Constructor ───────────────────────────────────────────────────────────
    lua_pushcfunction(L, [](lua_State* L2) -> int {
        size_t slen;
        const char* s = luaL_checklstring(L2, 1, &slen);

        // The destructor runs when the GC collects this userdata.
        // It receives the raw pointer cast to void*.  No __gc metamethod needed.
        MyBuffer* buf = (MyBuffer*)lua_newuserdatadtor(L2, sizeof(MyBuffer),
            [](void* ud) {
                MyBuffer* b = (MyBuffer*)ud;
                printf("  [dtor] freeing %zu bytes\n", b->len);
                free(b->data);
            });
        buf->data = (char*)malloc(slen);
        memcpy(buf->data, s, slen);
        buf->len  = slen;

        luaL_getmetatable(L2, "MyBuffer");
        lua_setmetatable(L2, -2);
        return 1;
    }, "MyBuffer.new");
    lua_setglobal(L, "MyBuffer");

    runLuau(L, R"(
        local b = MyBuffer("hello from userdata")
        print("  " .. tostring(b))
        print("  content: " .. b:read())
        print("  size:    " .. b:size())
        b = nil
        -- NOTE: collectgarbage() does not exist in Luau.
        -- Use lua_gc(L, LUA_GCCOLLECT, 0) from C to trigger collection.
    )");
    lua_gc(L, LUA_GCCOLLECT, 0); // triggers the dtor above

    lua_close(L);
})

// ─────────────────────────────────────────────────────────────────────────────
// 8. TAGGED USERDATA (Luau-specific)
//   Luau adds integer type tags (0 … LUA_UTAG_LIMIT-1) to full and light userdata.
//   Tags let C code distinguish types without inspecting the metatable.
//
//   Full userdata tags:
//   lua_newuserdatatagged(L, sz, tag)         — allocate with a tag
//   lua_touserdatatagged(L, idx, tag)         — returns ptr only if tag matches (else NULL)
//   lua_userdatatag(L, idx)                   — read the current tag
//   lua_setuserdatatag(L, idx, tag)           — change the tag at runtime
//   lua_setuserdatadtor(L, tag, dtor)         — one shared dtor for all instances of a tag
//   lua_setuserdatametatable / lua_getuserdatametatable — associate a metatable by tag
//
//   Light userdata tags:
//   lua_pushlightuserdatatagged(L, ptr, tag)  — push with a tag
//   lua_tolightuserdatatagged(L, idx, tag)    — returns ptr only if tag matches
//   lua_setlightuserdataname(L, tag, name)    — shown by lua_typename / luaL_typename
// ─────────────────────────────────────────────────────────────────────────────
enum { TAG_FOO = 1, TAG_BAR = 2 };
struct FooData { int value; };
struct BarData { float x, y; };

PlaygroundFunc(TaggedUserdata, {
    lua_State* L = luaL_newstate();
    luaL_openlibs(L);

    // ── One shared destructor per tag ─────────────────────────────────────────
    lua_setuserdatadtor(L, TAG_FOO, [](lua_State*, void* ud) {
        printf("  [TAG_FOO dtor] value=%d\n", ((FooData*)ud)->value);
    });
    lua_setuserdatadtor(L, TAG_BAR, [](lua_State*, void* ud) {
        BarData* b = (BarData*)ud;
        printf("  [TAG_BAR dtor] x=%.1f y=%.1f\n", b->x, b->y);
    });

    // ── Associate a metatable with TAG_FOO ────────────────────────────────────
    luaL_newmetatable(L, "FooMeta");
    lua_pushcfunction(L, [](lua_State* L2) -> int {
        // lua_touserdatatagged returns NULL on tag mismatch — O(1) type check.
        FooData* f = (FooData*)lua_touserdatatagged(L2, 1, TAG_FOO);
        if (!f) luaL_typeerror(L2, 1, "Foo");
        lua_pushfstring(L2, "Foo(%d)", f->value);
        return 1;
    }, "Foo.__tostring");
    lua_setfield(L, -2, "__tostring");
    // lua_setuserdatametatable stores the metatable (popped from stack) for a tag.
    // It is ONLY applied automatically by lua_newuserdatataggedwithmetatable, NOT
    // by lua_newuserdatatagged.  Use the "withmetatable" variant for auto-assignment.
    lua_setuserdatametatable(L, TAG_FOO);

    // ── Create tagged userdata ────────────────────────────────────────────────
    // lua_newuserdatataggedwithmetatable automatically fetches the registered metatable
    // via lua_getuserdatametatable and sets it — no manual lua_setmetatable needed.
    FooData* foo = (FooData*)lua_newuserdatataggedwithmetatable(L, sizeof(FooData), TAG_FOO);
    foo->value = 999;
    printf("  tag:                   %d\n", lua_userdatatag(L, -1));
    printf("  touserdatatagged(FOO): %p\n", lua_touserdatatagged(L, -1, TAG_FOO));
    printf("  touserdatatagged(BAR): %p (NULL = mismatch)\n", lua_touserdatatagged(L, -1, TAG_BAR));
    lua_setglobal(L, "myFoo");

    BarData* bar = (BarData*)lua_newuserdatatagged(L, sizeof(BarData), TAG_BAR);
    bar->x = 1.5f; bar->y = 2.5f;
    lua_setglobal(L, "myBar");

    // ── Named light userdata ──────────────────────────────────────────────────
    lua_setlightuserdataname(L, TAG_FOO, "FooPtr"); // shows up in typename output
    static int sentinel = 0;
    lua_pushlightuserdatatagged(L, &sentinel, TAG_FOO);
    printf("  light ud typename: %s\n", luaL_typename(L, -1)); // "FooPtr"
    lua_pop(L, 1);

    runLuau(L, R"LUAU(
        -- tostring calls Foo.__tostring because we used newuserdatataggedwithmetatable
        print("  myFoo = " .. tostring(myFoo))
        myFoo = nil; myBar = nil
        -- collectgarbage() does not exist in Luau; GC is controlled via lua_gc() from C.
    )LUAU");
    lua_gc(L, LUA_GCCOLLECT, 0); // triggers both TAG_FOO and TAG_BAR dtors

    lua_close(L);
})

// ─────────────────────────────────────────────────────────────────────────────
// 9. REFERENCE PINNING (lua_ref / lua_unref / lua_getref)
//   LUAU DIFFERENCE: standard Lua uses luaL_ref / luaL_unref (table + index).
//   Luau replaces these with:
//     lua_ref(L, idx)   — pin the value at idx; returns an int ref; does NOT pop
//     lua_unref(L, ref) — release the pin (no table argument)
//     lua_getref(L, ref)— push the pinned value (macro: rawgeti on registry)
//     LUA_NOREF (-1)    — sentinel for "no reference held"
//   Typical use: pin a Lua callback function for later invocation from C.
// ─────────────────────────────────────────────────────────────────────────────
PlaygroundFunc(ReferencePinning, {
    lua_State* L = luaL_newstate();
    luaL_openlibs(L);

    // ── Store a Lua callback from C ────────────────────────────────────────────
    int callbackRef = LUA_NOREF;

    lua_pushcfunction(L, [](lua_State* L2) -> int {
        luaL_checktype(L2, 1, LUA_TFUNCTION);
        // lua_ref does NOT pop — unlike luaL_ref in standard Lua which does pop.
        int ref = lua_ref(L2, 1);
        lua_pushinteger(L2, ref);
        return 1;
    }, "storeCallback");
    lua_setglobal(L, "storeCallback");

    runLuau(L, R"(
        _G._ref = storeCallback(function(x)
            print("  callback called with: " .. tostring(x))
        end)
        print("  stored ref = " .. _G._ref)
    )");

    lua_getglobal(L, "_ref");
    callbackRef = (int)lua_tointeger(L, -1);
    lua_pop(L, 1);

    // ── Invoke the pinned function from C ─────────────────────────────────────
    lua_getref(L, callbackRef);            // push pinned function
    lua_pushstring(L, "hello from C!");
    lua_pcall(L, 1, 0, 0);

    // ── Release the reference ─────────────────────────────────────────────────
    lua_unref(L, callbackRef);
    callbackRef = LUA_NOREF;

    // Retrieving LUA_NOREF is safe — pushes nil.
    lua_getref(L, LUA_NOREF);
    printf("  after unref, type = %s\n", lua_typename(L, lua_type(L, -1)));
    lua_pop(L, 1);

    lua_close(L);
})

// ─────────────────────────────────────────────────────────────────────────────
// 10. REGISTRY POINTER-KEYED PATTERN (the AwesomeWM uservalue shim)
//   LUA_REGISTRYINDEX is a pseudo-index for a table not accessible from Lua.
//   It's the right place to store C-side data associated with Lua objects.
//
//   lua_rawgetp(L, LUA_REGISTRYINDEX, ptr) — push registry[ptr] (no stack key push)
//   lua_rawsetp(L, LUA_REGISTRYINDEX, ptr) — pops value, stores registry[ptr]
//   These are macros for lua_rawgetptagged/rawsetptagged with tag=0.
//
//   This pattern implements luaA_setuservalue / luaA_getuservalue for AwesomeWM
//   because Luau's lua_getfenv/setfenv only work on functions and threads,
//   not on userdata.
// ─────────────────────────────────────────────────────────────────────────────
PlaygroundFunc(RegistryPointerKeyedPattern, {
    lua_State* L = luaL_newstate();
    luaL_openlibs(L);

    // setuservalue: pop table from top, store it keyed by the userdata pointer.
    auto setuservalue = [](lua_State* L2, int ud_idx) {
        void* ptr = lua_touserdata(L2, ud_idx);
        lua_rawsetp(L2, LUA_REGISTRYINDEX, ptr); // pops top value
    };

    // getuservalue: push the associated table (or nil if none set).
    auto getuservalue = [](lua_State* L2, int ud_idx) {
        void* ptr = lua_touserdata(L2, ud_idx);
        lua_rawgetp(L2, LUA_REGISTRYINDEX, ptr); // pushes registry[ptr]
    };

    void* ud = lua_newuserdata(L, 8);
    int ud_idx = lua_gettop(L);

    // Associate a table with the userdata
    lua_createtable(L, 0, 1);
    lua_pushstring(L, "hello from registry");
    lua_setfield(L, -2, "signal");
    setuservalue(L, ud_idx); // table popped here

    // Retrieve it later
    getuservalue(L, ud_idx);
    lua_getfield(L, -1, "signal");
    printf("  uservalue.signal = %s\n", lua_tostring(L, -1));
    lua_pop(L, 2);

    // GC cleanup: nil out the registry entry so the associated table can be collected.
    // In AwesomeWM's luaA_class_gc, this runs in the __gc metamethod:
    lua_pushnil(L);
    lua_rawsetp(L, LUA_REGISTRYINDEX, ud);   // registry[ptr] = nil
    getuservalue(L, ud_idx);
    printf("  after GC cleanup, type = %s\n", lua_typename(L, lua_type(L, -1)));
    lua_pop(L, 1);

    // ── rawsetp/rawgetp with tagged pointer keys ──────────────────────────────
    // lua_rawsetptagged(L, idx, ptr, tag) / lua_rawgetptagged(L, idx, ptr, tag)
    // Useful when you need distinct namespaces for the same pointer.
    static int myKey;
    lua_pushstring(L, "tagged-slot-value");
    lua_rawsetptagged(L, LUA_REGISTRYINDEX, &myKey, 1); // namespace tag=1
    lua_rawgetptagged(L, LUA_REGISTRYINDEX, &myKey, 1);
    printf("  tagged rawgetp: %s\n", lua_tostring(L, -1));
    lua_pop(L, 1);

    lua_close(L);
})

// ─────────────────────────────────────────────────────────────────────────────
// 11. ERROR HANDLING
//   lua_pcall(L, nargs, nresults, msgh) — protected call
//   lua_error(L)      — throw whatever is on top of the stack (longjmp)
//   luaL_error(L, fmt, ...) — push a formatted string and call lua_error
//   lua_cpcall(L, fn, ud)   — call a C function in protected mode
//   Errors can be any Lua value (string, number, table, userdata …)
// ─────────────────────────────────────────────────────────────────────────────
static int c_throw_table_error(lua_State* L) {
    lua_createtable(L, 0, 2);
    lua_pushinteger(L, 404);        lua_setfield(L, -2, "code");
    lua_pushstring(L, "not found"); lua_setfield(L, -2, "message");
    lua_error(L); // longjmp — never returns
    return 0;
}

PlaygroundFunc(ErrorHandling, {
    lua_State* L = luaL_newstate();
    luaL_openlibs(L);

    // ── String error from a C function ───────────────────────────────────────
    {
        lua_pushcfunction(L, [](lua_State* L2) -> int {
            luaL_error(L2, "something went wrong: %d", 42);
            return 0;
        }, "raiseErr");
        int s = lua_pcall(L, 0, 0, 0);
        printf("  status=%d, error: %s\n", s, lua_tostring(L, -1));
        lua_pop(L, 1);
    }

    // ── Table error object ────────────────────────────────────────────────────
    {
        lua_pushcfunction(L, c_throw_table_error, "throwTableErr");
        int s = lua_pcall(L, 0, 0, 0);
        if (s != LUA_OK && lua_istable(L, -1)) {
            lua_getfield(L, -1, "code");
            lua_getfield(L, -2, "message");
            printf("  table error: code=%d, message=%s\n",
                (int)lua_tointeger(L, -2), lua_tostring(L, -1));
            lua_pop(L, 3);
        }
    }

    // ── Nested pcalls: inner error doesn't escape the inner pcall ────────────
    {
        lua_pushcfunction(L, [](lua_State* L2) -> int {
            lua_pushcfunction(L2, [](lua_State* L3) -> int {
                luaL_error(L3, "inner error");
                return 0;
            }, "innerFn");
            int s = lua_pcall(L2, 0, 0, 0);
            lua_pushboolean(L2, s != LUA_OK);
            return 1;
        }, "outerFn");
        lua_pcall(L, 0, 1, 0);
        printf("  inner error caught by inner pcall: %s\n",
               lua_toboolean(L, -1) ? "yes" : "no");
        lua_pop(L, 1);
    }

    // ── lua_cpcall: call a C function in protected mode ────────────────────
    // The function receives a lightuserdata (the ud argument) at stack index 1.
    {
        int result = lua_cpcall(L, [](lua_State* L2) -> int {
            void* ud = lua_touserdata(L2, 1);
            printf("  cpcall ud=%p\n", ud);
            return 0;
        }, (void*)0x1234);
        printf("  cpcall status: %d\n", result);
    }

    lua_close(L);
})

// ─────────────────────────────────────────────────────────────────────────────
// 12. CLOSURES WITH UPVALUES
//   lua_pushcclosurek(L, fn, debugname, nup, continuation)
//   lua_pushcclosure(L, fn, debugname, nup)   — macro, no continuation
//   Before calling either, push 'nup' values onto the stack — they become
//   the upvalues and are popped from the stack.
//   lua_upvalueindex(i) — pseudo-index for the i-th upvalue (1-based)
//   lua_replace(L, lua_upvalueindex(i)) — update an upvalue in-place
// ─────────────────────────────────────────────────────────────────────────────
static int c_counter(lua_State* L) {
    int n = (int)lua_tointeger(L, lua_upvalueindex(1)) + 1;
    lua_pushinteger(L, n);
    lua_replace(L, lua_upvalueindex(1)); // write back the updated count
    lua_pushinteger(L, n);
    return 1;
}

PlaygroundFunc(ClosureWithUpvalues, {
    lua_State* L = luaL_newstate();
    luaL_openlibs(L);

    // ── Two independent counter closures (separate upvalue instances) ─────────
    lua_pushinteger(L, 0);
    lua_pushcclosure(L, c_counter, "counterA", 1); // nup=1, pops the integer
    lua_setglobal(L, "counterA");

    lua_pushinteger(L, 100); // counterB starts at 100
    lua_pushcclosure(L, c_counter, "counterB", 1);
    lua_setglobal(L, "counterB");

    runLuau(L, R"(
        print("  A: " .. counterA() .. ", " .. counterA() .. ", " .. counterA())
        print("  B: " .. counterB() .. ", " .. counterB())
        print("  A again: " .. counterA()) -- independent from B
    )");

    // ── Two closures sharing one table upvalue ────────────────────────────────
    // Both closures get a reference to the same table; mutations are shared.
    lua_createtable(L, 0, 1);
    lua_pushinteger(L, 0); lua_setfield(L, -2, "n"); // shared.n = 0

    lua_pushvalue(L, -1); // dup the table for 'inc' upvalue
    lua_pushcclosure(L, [](lua_State* L2) -> int {
        lua_getfield(L2, lua_upvalueindex(1), "n");
        int n = (int)lua_tointeger(L2, -1) + 1;
        lua_pop(L2, 1);
        lua_pushinteger(L2, n); lua_setfield(L2, lua_upvalueindex(1), "n");
        return 0;
    }, "inc", 1);
    lua_setglobal(L, "inc");

    // 'get' shares the same table object (still on top of C stack).
    // lua_pushcclosure with nup=1 pops 1 value from the stack as its upvalue.
    // The original table (now the only thing on the C stack) is consumed here.
    lua_pushcclosure(L, [](lua_State* L2) -> int {
        lua_getfield(L2, lua_upvalueindex(1), "n"); return 1;
    }, "get", 1); // pops the original table as get's upvalue
    lua_setglobal(L, "get");
    // Stack is now empty: no lua_pop needed.

    runLuau(L, "inc(); inc(); inc(); print('  shared counter = ' .. get())");

    lua_close(L);
})

// ─────────────────────────────────────────────────────────────────────────────
// 13. COROUTINES
//   lua_newthread(L)            — create a new coroutine sharing global state
//   lua_resume(co, from, narg)  — resume/start; narg values on co's stack
//   lua_status(co)              — LUA_OK (not started or finished), LUA_YIELD, …
//   lua_costatus(L, co)         — LUA_CORUN / COSUS / CONOR / COFIN / COERR
//   lua_isyieldable(L)          — true if C code can yield from this context
//   lua_setthreaddata / lua_getthreaddata — attach arbitrary C data to a thread
//
//   Yielding from Lua code works normally.  Yielding from a C function requires
//   a continuation closure (lua_pushcclosurek with a non-NULL lua_Continuation).
// ─────────────────────────────────────────────────────────────────────────────
PlaygroundFunc(CoroutineBasics, {
    lua_State* L = luaL_newstate();
    luaL_openlibs(L);

    runLuau(L, R"(
        function gen(max)
            for i = 1, max do
                coroutine.yield(i * i)
            end
            return "done"
        end
    )");

    lua_State* co = lua_newthread(L);
    int co_ref = lua_ref(L, -1); // pin so the GC doesn't collect the coroutine
    lua_pop(L, 1);

    lua_getglobal(co, "gen");
    lua_pushinteger(co, 5); // max = 5
    int status = lua_resume(co, L, 1); // first resume starts the coroutine

    while (status == LUA_YIELD) {
        int nvals = lua_gettop(co);
        printf("  yielded:");
        for (int i = 1; i <= nvals; i++) printf(" %g", lua_tonumber(co, i));
        printf("\n");
        lua_settop(co, 0); // pop yield values
        status = lua_resume(co, L, 0);
    }

    if (status == LUA_OK)
        printf("  coroutine finished: %s\n", lua_tostring(co, -1));
    else
        printf("  coroutine error: %s\n", lua_tostring(co, -1));

    // NOTE: In Luau, lua_costatus returns LUA_COSUS (1) for a normally-finished
    // coroutine, NOT LUA_COFIN (3).  Use lua_status(co)==LUA_OK to detect completion.
    printf("  costatus: %d  (LUA_COSUS=%d, LUA_COFIN=%d)\n",
           lua_costatus(L, co), LUA_COSUS, LUA_COFIN);
    lua_unref(L, co_ref);

    // ── Per-thread C data (Luau-specific) ─────────────────────────────────────
    lua_State* co2 = lua_newthread(L);
    static int payload = 42;
    lua_setthreaddata(co2, &payload);
    printf("  thread data: %d\n", *(int*)lua_getthreaddata(co2));
    lua_pop(L, 1);

    lua_close(L);
})

// ─────────────────────────────────────────────────────────────────────────────
// 14. STRING BUFFER (luaL_Strbuf / luaL_Buffer)
//   Efficiently builds up a string in C without repeated GC allocations.
//   The buffer uses a small inline array first and spills to a heap-backed
//   Lua string when exhausted.
//   luaL_buffinit(L, B)       — initialize (does NOT push anything onto the stack)
//   luaL_addstring(B, s)      — append a null-terminated C string
//   luaL_addlstring(B, s, l)  — append l bytes
//   luaL_addchar(B, c)        — append one char
//   luaL_addvalue(B)          — append and pop the Lua string on top of stack
//   luaL_addvalueany(B, idx)  — append value at any stack index
//   luaL_pushresult(B)        — finalize: push the accumulated string
// ─────────────────────────────────────────────────────────────────────────────
static int c_join(lua_State* L) {
    const char* sep = luaL_checkstring(L, 1);
    int n = lua_gettop(L) - 1;

    luaL_Buffer B;
    luaL_buffinit(L, &B);
    for (int i = 2; i <= n + 1; i++) {
        if (i > 2) luaL_addstring(&B, sep);
        size_t len;
        // luaL_tolstring pushes a string form; luaL_addvalue appends+pops it.
        luaL_tolstring(L, i, &len);
        luaL_addvalue(&B);
    }
    luaL_pushresult(&B);
    return 1;
}

PlaygroundFunc(StringBuffer, {
    lua_State* L = luaL_newstate();
    luaL_openlibs(L);

    lua_pushcfunction(L, c_join, "join");
    lua_setglobal(L, "join");

    runLuau(L, R"(
        print("  " .. join(", ", "apple", "banana", 42, true))
        print("  " .. join(" | ", "x", "y", "z"))
    )");

    // ── Build a string entirely in C ──────────────────────────────────────────
    luaL_Buffer B;
    luaL_buffinit(L, &B);
    luaL_addstring(&B, "built-in-C-");
    lua_pushinteger(L, 2026);  // push a Lua value
    luaL_addvalue(&B);         // appends + pops
    luaL_addchar(&B, '!');
    luaL_pushresult(&B);
    printf("  %s\n", lua_tostring(L, -1));
    lua_pop(L, 1);

    lua_close(L);
})

// ─────────────────────────────────────────────────────────────────────────────
// 15. VECTOR TYPE (Luau-specific)
//   Luau has a native fixed-size vector (3 floats by default, 4 with LUA_VECTOR_SIZE=4).
//   It's a value type stored inline — not heap-allocated, not GC'd.
//   lua_pushvector(L, x, y, z) — push a vector from C
//   lua_tovector(L, idx)        — returns const float* [x, y, z (, w)]
//   lua_isvector(L, idx)        — type predicate
//   luaL_checkvector(L, idx)    — same with error on mismatch
//   LUA_TVECTOR                 — type enum value
//
//   From Luau CODE: 'vector' is a *library table*, not a global constructor.
//   Create vectors via vector.create(x, y, z).
//   The compiler can inline vector.create() as a builtin when lua_CompileOptions
//   has vectorLib="vector" and vectorCtor="create" set.
// ─────────────────────────────────────────────────────────────────────────────
PlaygroundFunc(VectorType, {
    lua_State* L = luaL_newstate();
    luaL_openlibs(L);

    // ── Create and inspect a vector from C ────────────────────────────────────
    lua_pushvector(L, 1.0f, 2.0f, 3.0f);
    printf("  is vector: %d\n", lua_isvector(L, -1));
    const float* v = lua_tovector(L, -1);
    printf("  vector = (%.1f, %.1f, %.1f)\n", v[0], v[1], v[2]);
    lua_pop(L, 1);

    // ── C functions that take/return vectors ──────────────────────────────────
    lua_pushcfunction(L, [](lua_State* L2) -> int {
        const float* a = luaL_checkvector(L2, 1);
        const float* b = luaL_checkvector(L2, 2);
        lua_pushnumber(L2, (double)(a[0]*b[0] + a[1]*b[1] + a[2]*b[2]));
        return 1;
    }, "dot");
    lua_setglobal(L, "dot");

    lua_pushcfunction(L, [](lua_State* L2) -> int {
        const float* a = luaL_checkvector(L2, 1);
        const float* b = luaL_checkvector(L2, 2);
        lua_pushvector(L2,
            a[1]*b[2] - a[2]*b[1],
            a[2]*b[0] - a[0]*b[2],
            a[0]*b[1] - a[1]*b[0]);
        return 1;
    }, "cross");
    lua_setglobal(L, "cross");

    // ── Use vectors from Luau via vector.create() ─────────────────────────────
    // With lua_CompileOptions.vectorLib="vector" / vectorCtor="create", the
    // compiler inlines vector.create calls as the NEWVECTOR bytecode instruction.
    lua_CompileOptions opts{};
    opts.optimizationLevel = 1;
    opts.debugLevel        = 1;
    opts.vectorLib         = "vector";  // library name
    opts.vectorCtor        = "create";  // constructor function within that library

    const char* src = R"(
        local x = vector.create(1, 0, 0)
        local y = vector.create(0, 1, 0)
        print("  dot(x, y)   = " .. dot(x, y))
        local z = cross(x, y)
        print("  cross(x, y) = " .. tostring(z))
    )";
    size_t bcLen = 0;
    char* bc = luau_compile(src, strlen(src), &opts, &bcLen);
    luau_load(L, "=[vec]", bc, bcLen, 0);
    free(bc);
    lua_pcall(L, 0, 0, 0);

    lua_close(L);
})

// ─────────────────────────────────────────────────────────────────────────────
// 16. BUFFER TYPE (Luau-specific)
//   A GC-managed mutable binary blob.  Unlike strings: mutable, not interned.
//   lua_newbuffer(L, sz)        — allocate sz zero-initialized bytes; push it
//   lua_tobuffer(L, idx, &len)  — returns raw void* and fills *len
//   lua_isbuffer(L, idx)        — type predicate
//   LUA_TBUFFER                 — type enum value
//   The Lua-side 'buffer' library exposes buffer.create/read*/write*/len/copy/fill.
// ─────────────────────────────────────────────────────────────────────────────
PlaygroundFunc(BufferType, {
    lua_State* L = luaL_newstate();
    luaL_openlibs(L);

    // ── Create and write from C ───────────────────────────────────────────────
    size_t sz = 8;
    void* buf = lua_newbuffer(L, sz);
    char* bytes = (char*)lua_tobuffer(L, -1, &sz);
    for (size_t i = 0; i < sz; i++) bytes[i] = (char)(i * 3); // mutable!
    printf("  type: %s\n", lua_typename(L, lua_type(L, -1)));  // "buffer"
    printf("  size: %zu  bytes[0..3]: %d %d %d %d\n",
           sz, bytes[0], bytes[1], bytes[2], bytes[3]);
    lua_setglobal(L, "myBuf");

    // ── Access from Luau via the buffer library ───────────────────────────────
    runLuau(L, R"(
        local b = buffer.create(4)
        buffer.writeu8(b, 0, 0xFF)
        buffer.writeu16(b, 1, 0x1234)
        print("  b[0] = " .. buffer.readu8(b, 0))    -- 255
        print("  b[1] = " .. buffer.readu16(b, 1))   -- 0x1234 = 4660
        print("  myBuf len = " .. buffer.len(myBuf)) -- 8
    )");

    lua_close(L);
})

// ─────────────────────────────────────────────────────────────────────────────
// 17. GARBAGE COLLECTION CONTROL
//   lua_gc(L, op, data) — all GC operations go through this one function.
//   LUA_GCSTOP / GCRESTART   — pause / resume the incremental collector
//   LUA_GCCOLLECT            — run a full cycle (avoid in latency-sensitive code)
//   LUA_GCCOUNT / GCCOUNTB   — heap size in KB and remainder bytes
//   LUA_GCSTEP               — explicit step of `data` KB of collection work
//   LUA_GCISRUNNING          — 1 if GC is active
//   LUA_GCSETGOAL            — heap-to-live-data ratio goal (default 200%)
//   LUA_GCSETSTEPMUL         — collector pace vs allocation (default 200%)
//   lua_setmemcat / lua_totalbytes — per-category memory accounting (Luau)
// ─────────────────────────────────────────────────────────────────────────────
PlaygroundFunc(GarbageCollection, {
    lua_State* L = luaL_newstate();
    luaL_openlibs(L);

    int kb  = lua_gc(L, LUA_GCCOUNT,  0);
    int rem = lua_gc(L, LUA_GCCOUNTB, 0);
    printf("  initial heap: %d KB + %d bytes\n", kb, rem);

    lua_gc(L, LUA_GCSTOP, 0);
    printf("  GC running: %d\n", lua_gc(L, LUA_GCISRUNNING, 0)); // 0

    // Allocate without collection
    runLuau(L, "for i = 1, 500 do local t = {i, i*2, i*3} end");
    printf("  heap after alloc (GC stopped): %d KB\n", lua_gc(L, LUA_GCCOUNT, 0));

    lua_gc(L, LUA_GCRESTART, 0);
    lua_gc(L, LUA_GCCOLLECT, 0); // full cycle
    printf("  heap after full collect:       %d KB\n", lua_gc(L, LUA_GCCOUNT, 0));

    // Tune GC: goal=150% (tighter heap), stepmul=300% (faster collector)
    lua_gc(L, LUA_GCSETGOAL,    150);
    lua_gc(L, LUA_GCSETSTEPMUL, 300);

    // Memory categories: attribute allocations to a numbered category (0..15)
    lua_setmemcat(L, 2);
    runLuau(L, "local s = string.rep('x', 100000)");
    printf("  category 2 bytes: %zu\n", lua_totalbytes(L, 2));
    lua_setmemcat(L, 0);

    lua_close(L);
})

// ─────────────────────────────────────────────────────────────────────────────
// 18. DEBUG API
//   lua_getinfo(L, level, what, &ar) — fill a lua_Debug from a call-stack level
//     'n' → name, what (function name and type)
//     's' → source, short_src, linedefined
//     'l' → currentline
//     'u' → nupvals, nparams, isvararg
//   lua_stackdepth(L)               — number of frames on the call stack
//   lua_getlocal(L, level, n)       — push + return name of local n at level
//   lua_getupvalue(L, funcidx, n)   — push + return name of upvalue n
//   lua_setupvalue(L, funcidx, n)   — pop + set upvalue n (returns name)
//   lua_debugtrace(L)               — quick non-thread-safe trace dump
// ─────────────────────────────────────────────────────────────────────────────
PlaygroundFunc(DebugAPI, {
    lua_State* L = luaL_newstate();
    luaL_openlibs(L);

    // ── Inspect the live call stack from inside a C function ─────────────────
    lua_pushcfunction(L, [](lua_State* L2) -> int {
        printf("  stack depth: %d\n", lua_stackdepth(L2));
        for (int lvl = 0; ; lvl++) {
            lua_Debug ar;
            if (!lua_getinfo(L2, lvl, "nsl", &ar)) break;
            printf("  [%d] %-6s %-20s line=%d defined=%d\n",
                lvl,
                ar.what       ? ar.what       : "?",
                ar.name       ? ar.name       : "(anon)",
                ar.currentline,
                ar.linedefined);
        }
        return 0;
    }, "inspectStack");
    lua_setglobal(L, "inspectStack");

    runLuau(L, R"(
        local function inner() inspectStack() end
        local function outer() inner() end
        outer()
    )");

    // ── Inspect upvalues of a known closure ───────────────────────────────────
    lua_pushinteger(L, 77);
    lua_pushcclosure(L, [](lua_State* L2) -> int { return 0; }, "myClosureWithUpval", 1);

    const char* upname = lua_getupvalue(L, -1, 1); // push upvalue 1; return name
    printf("  upvalue name='%s', value=%d\n",
           upname ? upname : "(unnamed)", (int)lua_tointeger(L, -1));
    lua_pop(L, 2); // pop upvalue + closure

    // Mutate an upvalue from C
    lua_pushinteger(L, 0);
    lua_pushcclosure(L, c_counter, "mutCounter", 1);
    lua_pushinteger(L, 999);                      // new upvalue value
    lua_setupvalue(L, -2, 1);                     // pops 999, sets upvalue 1
    lua_getupvalue(L, -1, 1);
    printf("  after setupvalue: %d\n", (int)lua_tointeger(L, -1));
    lua_pop(L, 2); // pop upvalue + closure

    lua_close(L);
})

// ─────────────────────────────────────────────────────────────────────────────
// 19. VM CALLBACKS (lua_Callbacks)
//   lua_callbacks(L) returns a per-VM struct of hook pointers shared across
//   all coroutines.  All except 'interrupt' must be set before VM code runs.
//
//   .panic(L, errcode)     — replaces lua_atpanic (does not exist in Luau)
//                            signature: void(lua_State*, int)
//   .interrupt(L, gc)      — called at every safepoint (back-edges, call/ret, GC)
//                            safe to set/change from any thread at any time
//   .userthread(LP, L)     — LP=parent on creation, NULL on destruction
//   .userdata              — arbitrary pointer, never touched by the VM
// ─────────────────────────────────────────────────────────────────────────────
PlaygroundFunc(CallbackHooks, {
    lua_State* L = luaL_newstate();
    luaL_openlibs(L);

    lua_Callbacks* cb = lua_callbacks(L);

    // ── Panic handler (Luau replacement for lua_atpanic) ──────────────────────
    cb->panic = [](lua_State* L2, int errcode) {
        const char* msg = lua_tostring(L2, -1);
        fprintf(stderr, "  [panic] code=%d msg=%s\n", errcode, msg ? msg : "(none)");
        // Do not longjmp here — just log; the process will exit after returning.
    };

    // ── Instruction-budget interrupt ──────────────────────────────────────────
    // interrupt fires at every safepoint; we use cb->userdata to track a counter.
    struct Budget { int remaining; };
    Budget budget{30};
    cb->userdata  = &budget;
    cb->interrupt = [](lua_State* L2, int /*gc*/) {
        Budget* b = (Budget*)lua_callbacks(L2)->userdata;
        if (--b->remaining <= 0)
            luaL_error(L2, "instruction budget exhausted");
    };

    // Directly compile + load + pcall (no inner pcall wrapper) so the interrupt
    // error propagates all the way to our outer lua_pcall below.
    const char* tightLoop = "local x=0; for i=1,1000000 do x=x+i end; return x";
    size_t bcLen = 0;
    char* bc = luau_compile(tightLoop, strlen(tightLoop), nullptr, &bcLen);
    luau_load(L, "=[loop]", bc, bcLen, 0);
    free(bc);
    int s = lua_pcall(L, 0, 1, 0);
    printf("  interrupt fired: %s (status=%d)\n",
           s != LUA_OK ? lua_tostring(L, -1) : "no — budget not hit", s);
    if (s != LUA_OK) lua_pop(L, 1);

    // ── Coroutine lifecycle tracking via userthread ────────────────────────────
    cb->interrupt = nullptr;
    cb->userthread = [](lua_State* parent, lua_State* child) {
        if (parent)
            printf("  [userthread] created  parent=%p child=%p\n", (void*)parent, (void*)child);
        else
            printf("  [userthread] destroyed child=%p\n", (void*)child);
    };
    {
        lua_State* co = lua_newthread(L); // → userthread(L, co)
        (void)co;
        lua_pop(L, 1);
        lua_gc(L, LUA_GCCOLLECT, 0);     // → userthread(NULL, co)
    }

    lua_close(L);
})

// ─────────────────────────────────────────────────────────────────────────────
// 20. REGISTERING A C LIBRARY MODULE (luaL_register)
//   luaL_register(L, libname, luaL_Reg[]) — creates/extends _G[libname] with the
//   functions in the null-terminated luaL_Reg array, and pushes the table.
//   If libname is NULL, it extends whatever table is already on the stack top.
//   This is the idiomatic way to expose a group of C functions as a Lua module.
// ─────────────────────────────────────────────────────────────────────────────
static const luaL_Reg awesome_lib[] = {
    {"version",   [](lua_State* L) -> int {
        lua_pushstring(L, "awesome-luau/0.1.0"); return 1;
    }},
    {"uptime_ms", [](lua_State* L) -> int {
        lua_pushnumber(L, lua_clock() * 1000.0); return 1;
    }},
    {"noop",      [](lua_State* L) -> int { return 0; }},
    {nullptr, nullptr}
};

PlaygroundFunc(RegisterCLibrary, {
    lua_State* L = luaL_newstate();
    luaL_openlibs(L);

    luaL_register(L, "awesome", awesome_lib); // creates _G.awesome = { ... }
    lua_pop(L, 1); // pop the module table

    // Extend the module later (e.g. from a second C file)
    lua_getglobal(L, "awesome");
    lua_pushcfunction(L, [](lua_State* L2) -> int {
        lua_pushboolean(L2, 1); return 1;
    }, "awesome.alive");
    lua_setfield(L, -2, "alive"); // awesome.alive = fn
    lua_pop(L, 1);

    runLuau(L, R"(
        print("  version:   " .. awesome.version())
        print("  alive:     " .. tostring(awesome.alive()))
        print("  uptime_ms: " .. math.floor(awesome.uptime_ms()) .. " ms")
    )");

    // Enumerate registered functions
    printf("  registered functions:\n");
    lua_getglobal(L, "awesome");
    lua_pushnil(L);
    while (lua_next(L, -2)) {
        if (lua_isfunction(L, -1))
            printf("    awesome.%s\n", lua_tostring(L, -2));
        lua_pop(L, 1);
    }
    lua_pop(L, 1);

    lua_close(L);
})

// ─────────────────────────────────────────────────────────────────────────────
// ORIGINAL: Registry storage and retrieval via lightuserdata key
// ─────────────────────────────────────────────────────────────────────────────
PlaygroundFunc(RegistryStorageAndRetrieval, {
    lua_State *L = luaL_newstate();
    luaL_openlibs(L);

    int dummy = 42;
    void *key = &dummy;

    lua_createtable(L, 0, 0);
    lua_pushlightuserdatatagged(L, key, 0);
    lua_pushvalue(L, -2);
    lua_rawset(L, LUA_REGISTRYINDEX); // registry[key] = table
    lua_pop(L, 1);                    // pop original table

    lua_pushlightuserdatatagged(L, key, 0);
    lua_rawget(L, LUA_REGISTRYINDEX); // push registry[key]
    printf("  type: %s\n", lua_typename(L, lua_type(L, -1))); // "table"

    lua_close(L);
})

