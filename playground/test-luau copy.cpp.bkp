    std::cout << BRACKET_STR << std::endl;

    CheckPlaygroundFunc(StackBasics);
    CheckPlaygroundFunc(ExecuteLuauCode);
    CheckPlaygroundFunc(CFunctionAsLuauGlobal);
    CheckPlaygroundFunc(CallLuaFunctionFromC);
    CheckPlaygroundFunc(TableManipulation);
    CheckPlaygroundFunc(MetatableBasics);
    CheckPlaygroundFunc(UserdataWithDtor);
    CheckPlaygroundFunc(TaggedUserdata);
    CheckPlaygroundFunc(ReferencePinning);
    CheckPlaygroundFunc(RegistryPointerKeyedPattern);
    CheckPlaygroundFunc(ErrorHandling);
    CheckPlaygroundFunc(ClosureWithUpvalues);
    CheckPlaygroundFunc(CoroutineBasics);
    CheckPlaygroundFunc(StringBuffer);
    CheckPlaygroundFunc(VectorType);
    CheckPlaygroundFunc(BufferType);
    CheckPlaygroundFunc(GarbageCollection);
    CheckPlaygroundFunc(DebugAPI);
    CheckPlaygroundFunc(CallbackHooks);
    CheckPlaygroundFunc(RegisterCLibrary);
    CheckPlaygroundFunc(RegistryStorageAndRetrieval);

    std::cout << BRACKET_STR << std::endl;
    return 0;
}
